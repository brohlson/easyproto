#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
root="$PWD"
desktop="$root/apps/desktop"
name='Easy Proto'
applications="$HOME/Applications"
destination="$applications/$name.app"
[[ "$(uname -s)" == Darwin ]] || { echo 'Requires macOS.' >&2; exit 1; }

# Prefer the checkout's pinned Node when the account has several runtimes.
version="$(cat .nvmrc)"
for bin in "${NVM_DIR:-$HOME/.nvm}/versions/node/v$version/bin" "${VITE_PLUS_HOME:-$HOME/.vite-plus}/js_runtime/node/$version/bin"; do
  if [[ -x "$bin/node" ]]; then export PATH="$bin:$PATH"; break; fi
done

mkdir -p "$applications"
lock="$applications/.easy-proto-install.lock"
shlock -f "$lock" -p "$$" || { echo 'Another Easy Proto install is in progress.' >&2; exit 1; }
work=''
cleanup() {
  if [[ -n "$work" ]]; then rm -rf "$work"; fi
  rm -f "$lock"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
work="$(mktemp -d "$applications/.easy-proto-install.XXXXXX")"
mkdir -p "$work/bin"
corepack enable --install-directory "$work/bin" pnpm
export PATH="$work/bin:$PATH"

store="$(dirname "$(pnpm store path)")"
if [[ -d "$root/.pnpm-store/v10" ]]; then store="$root/.pnpm-store"; fi
pnpm --store-dir "$store" install --frozen-lockfile
pnpm --filter @easy-proto/desktop exec install-electron --no
pnpm desktop:build
candidate="$work/$name.app"
bash scripts/package-mac "$candidate"
codesign --force --deep --sign - "$candidate"
codesign --verify --deep --strict "$candidate"
cmp "$desktop/packaging/EasyProto.icns" "$candidate/Contents/Resources/$(plutil -extract CFBundleIconFile raw "$candidate/Contents/Info.plist")"
node "$desktop/scripts/check-mac-install.mjs" "$candidate" "$work/profile"
swift "$desktop/scripts/replace-mac-app.swift" "$candidate" "$destination"
open "$destination"
echo "Installed $destination"
