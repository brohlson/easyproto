{
  "name": "easy-proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "local:setup": "node scripts/local-web.mjs setup",
    "local:dev": "node scripts/local-web.mjs dev",
    "local:verify": "pnpm --filter @easy-proto/desktop build && node --test scripts/local-web-server.test.mjs apps/desktop/verify/web-sync.test.mjs",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @easy-proto/desktop dev",
    "start": "pnpm --filter @easy-proto/desktop start",
    "desktop:build": "pnpm --filter @easy-proto/desktop build",
    "desktop:verify": "pnpm --filter @easy-proto/desktop verify",
    "project:import-sqlite": "pnpm --filter @easy-proto/desktop project:import-sqlite",
    "tokens:sync": "pnpm --filter @easy-proto/desktop tokens:sync",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "fmt:check": "oxfmt --check '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm lint && pnpm fmt:check && node --test scripts/local-web-server.test.mjs && pnpm -r --if-present verify",
    "web:dev": "pnpm --filter @easy-proto/web dev",
    "web:build": "pnpm --filter @easy-proto/web build",
    "web:start": "pnpm --filter @easy-proto/web start",
    "web:verify": "pnpm --filter @easy-proto/web verify"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.59.1"
  }
}
