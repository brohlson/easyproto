{
  "name": "@easy-proto/desktop",
  "productName": "easy-proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "project:import-sqlite": "node scripts/import-sqlite-project.mjs",
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm build && node --test --test-concurrency=1 verify/*.test.mjs",
    "verify:chatgpt-live": "node verify/chatgpt-live.mjs"
  },
  "dependencies": {
    "@easy-proto/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xyflow/react": "12.12.1",
    "jose": "6.2.17",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.73.0",
    "parse5": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "style-dictionary": "5.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "playwright": "1.59.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
