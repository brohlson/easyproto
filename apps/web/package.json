{
  "name": "@easy-proto/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "cf dev --host 127.0.0.1 --port 8787",
    "start": "vite preview --host 127.0.0.1 --port 8787",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "verify": "pnpm typecheck && pnpm build && node --test worker.test.mjs local-security.test.mjs && pnpm demo:verify",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:verify": "pnpm demo:build && node --test viewer.test.mjs",
    "demo:start": "node demo/server.mjs"
  },
  "dependencies": {
    "@easy-proto/preview": "workspace:*",
    "@easy-proto/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-rc.4",
    "playwright": "1.59.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
