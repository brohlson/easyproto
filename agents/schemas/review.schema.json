{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-canvas:review:1",
  "title": "Local Canvas review report",
  "description": "Report structure only. Runner provenance, required roles, freshness, evidence truth, and blocking policy require separate enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "reviewerRunId",
    "role",
    "baseCommit",
    "reviewedCommit",
    "policyVersion",
    "scope",
    "result",
    "checks",
    "findings",
    "uncertainties"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "changeId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerRunId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "design",
        "frontend",
        "security",
        "infrastructure",
        "architecture-reliability"
      ]
    },
    "baseCommit": {
      "$ref": "#/$defs/commit"
    },
    "reviewedCommit": {
      "$ref": "#/$defs/commit"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "enum": [
        "pass",
        "changes_required",
        "needs_evidence"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "method",
        "executionRef",
        "evidence",
        "limitations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "executionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "location",
        "evidence",
        "impact",
        "requirement",
        "correction",
        "owner",
        "verification",
        "disposition",
        "closure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor",
            "suggestion"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "open",
            "fixed_verified",
            "deferred",
            "accepted_risk",
            "dismissed_with_evidence"
          ]
        },
        "closure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/closure"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "open"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "closure": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "fixed_verified"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "closure": {
                "type": "object",
                "properties": {
                  "verifiedCommit": {
                    "$ref": "#/$defs/commit"
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "deferred"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "closure": {
                "type": "object",
                "properties": {
                  "trackingRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revisitCondition": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "dismissed_with_evidence"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "closure": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "accepted_risk"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "closure": {
                "type": "object",
                "properties": {
                  "decisionRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revisitCondition": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "verifiedCommit",
        "evidence",
        "trackingRef",
        "revisitCondition",
        "decisionRef"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "verifiedCommit": {
          "oneOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trackingRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisitCondition": {
          "type": [
            "string",
            "null"
          ]
        },
        "decisionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
